<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Manage Services</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="container mt-5">
    <h2>Manage Services</h2>
    <% errors.forEach(error => { %><div class="alert alert-danger"><%= error %></div><% }); %>
    <% messages.forEach(message => { %><div class="alert alert-success"><%= message %></div><% }); %>
    <a href="/admin/services/new" class="btn btn-primary mb-3">Add service</a>
    <table class="table table-bordered table-striped">
      <thead class="table-dark">
        <tr><th>Service</th><th>Description</th><th>Price</th><th>Duration</th><th>Status</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% if (services.length === 0) { %>
          <tr><td colspan="6" class="text-center">No services have been added.</td></tr>
        <% } else { %>
          <% services.forEach(service => { %>
            <tr>
              <td><%= service.name %></td>
              <td><%= service.description || '-' %></td>
              <td>$<%= Number(service.cost).toFixed(2) %></td>
              <td><%= service.duration %> min</td>
              <td><%= service.is_active ? 'Active' : 'Inactive' %></td>
              <td>
                <% if (service.is_active) { %>
                  <a href="/admin/services/<%= service.service_id %>/edit" class="btn btn-sm btn-warning">Edit</a>
                  <form action="/admin/services/<%= service.service_id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Remove this service from the customer catalogue? Existing bookings will be kept.');">
                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                  </form>
                <% } else { %>
                  <span class="text-muted">Not available for new bookings</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </main>
</body>
</html>
