<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Pet Care Services</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="container mt-5">
    <h2 class="mb-4">Available Services</h2>
    <% errors.forEach(error => { %><div class="alert alert-danger"><%= error %></div><% }); %>
    <% messages.forEach(message => { %><div class="alert alert-success"><%= message %></div><% }); %>

    <% if (services.length === 0) { %>
      <div class="alert alert-info">There are no services available right now. Please check back later.</div>
    <% } else if (pets.length === 0) { %>
      <div class="alert alert-warning">Add a pet before booking a service. <a href="/pets/new">Add a pet</a>.</div>
    <% } else { %>
      <form action="/bookings" method="POST">
        <div class="row g-3">
          <% services.forEach(service => { %>
            <div class="col-md-6 col-lg-4">
              <label class="card h-100">
                <div class="card-body">
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="serviceIds" value="<%= service.service_id %>">
                    <span class="form-check-label fw-bold"><%= service.name %></span>
                  </div>
                  <p class="mt-2 mb-1"><%= service.description || 'No description provided.' %></p>
                  <p class="mb-0"><strong>Price:</strong> $<%= Number(service.cost).toFixed(2) %></p>
                  <p class="mb-0"><strong>Duration:</strong> <%= service.duration %> minutes</p>
                </div>
              </label>
            </div>
          <% }); %>
        </div>

        <div class="card mt-4">
          <div class="card-body">
            <h5>Booking details</h5>
            <div class="mb-3">
              <label for="petId" class="form-label">Pet</label>
              <select id="petId" name="petId" class="form-select" required>
                <option value="">Choose your pet</option>
                <% pets.forEach(pet => { %>
                  <option value="<%= pet.id %>"><%= pet.name %> (<%= pet.species %>)</option>
                <% }); %>
              </select>
            </div>
            <div class="mb-3">
              <label for="startTime" class="form-label">Date and time</label>
              <input id="startTime" name="startTime" type="datetime-local" class="form-control" required>
            </div>
            <button type="submit" class="btn btn-primary">Book selected services</button>
            <a href="/bookings" class="btn btn-outline-secondary">My bookings</a>
          </div>
        </div>
      </form>
    <% } %>
  </main>
</body>
</html>
