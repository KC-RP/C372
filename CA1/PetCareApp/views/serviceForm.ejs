<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= service ? 'Edit Service' : 'Add Service' %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="container mt-5" style="max-width: 720px">
    <h2><%= service ? 'Edit Service' : 'Add Service' %></h2>
    <% errors.forEach(error => { %><div class="alert alert-danger"><%= error %></div><% }); %>
    <form action="<%= action %>" method="POST">
      <div class="mb-3">
        <label for="name" class="form-label">Service name</label>
        <input id="name" name="name" class="form-control" maxlength="100" value="<%= service ? service.name : '' %>" required>
      </div>
      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea id="description" name="description" class="form-control" rows="4"><%= service ? service.description || '' : '' %></textarea>
      </div>
      <div class="mb-3">
        <label for="cost" class="form-label">Price</label>
        <input id="cost" name="cost" type="number" class="form-control" min="0" step="0.01" value="<%= service ? Number(service.cost).toFixed(2) : '' %>" required>
      </div>
      <div class="mb-3">
        <label for="duration" class="form-label">Duration (minutes)</label>
        <input id="duration" name="duration" type="number" class="form-control" min="1" max="65535" step="1" value="<%= service ? service.duration : '' %>" required>
      </div>
      <button type="submit" class="btn btn-primary">Save service</button>
      <a href="/admin/services" class="btn btn-outline-secondary">Cancel</a>
    </form>
  </main>
</body>
</html>
