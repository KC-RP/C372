<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Booking Confirmation</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="container mt-5" style="max-width: 760px">
    <div class="alert alert-success">
      <h2>Booking confirmed</h2>
      <p class="mb-0">Your booking details are shown below and are available in My Bookings.</p>
    </div>
    <section class="card">
      <div class="card-header">Booking #<%= booking.booking_id %></div>
      <div class="card-body">
        <p><strong>Pet:</strong> <%= booking.pet_name %> (<%= booking.pet_species %>)</p>
        <p><strong>Date and time:</strong> <%= booking.start_time_display %> - <%= booking.end_time_display %></p>
        <h5>Services</h5>
        <ul>
          <% booking.services.forEach(service => { %>
            <li><%= service.name %> - $<%= Number(service.price).toFixed(2) %> (<%= service.duration %> min)</li>
          <% }); %>
        </ul>
        <p><strong>Total:</strong> $<%= Number(booking.price).toFixed(2) %></p>
        <p><strong>Payment:</strong> <span class="badge text-bg-success">Paid</span></p>
        <p><strong>Status:</strong> <%= booking.status %></p>
        <a href="/bookings" class="btn btn-primary">My Bookings</a>
        <a href="/services" class="btn btn-outline-secondary">Browse services</a>
      </div>
    </section>
  </main>
</body>
</html>
