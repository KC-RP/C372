<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Payment Result</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="container py-5">
    <h1 class="h2 mb-4">Mock Payment Result</h1>
    <% if (paymentStatus === 'APPROVED') { %>
      <div class="alert alert-success" role="status">Payment approved. The booking is confirmed.</div>
    <% } else if (paymentStatus === 'PENDING') { %>
      <div class="alert alert-warning" role="status">Payment is pending. The booking is awaiting payment.</div>
    <% } else { %>
      <div class="alert alert-danger" role="status">Payment declined. The booking could not be confirmed.</div>
    <% } %>

    <dl class="row">
      <dt class="col-sm-3">Booking</dt>
      <dd class="col-sm-9">#<%= bookingId %></dd>
      <dt class="col-sm-3">Service</dt>
      <dd class="col-sm-9"><%= serviceName %></dd>
      <dt class="col-sm-3">Amount</dt>
      <dd class="col-sm-9">S$<%= amount.toFixed(2) %></dd>
      <dt class="col-sm-3">Payment status</dt>
      <dd class="col-sm-9"><%= paymentStatus %></dd>
      <dt class="col-sm-3">Booking status</dt>
      <dd class="col-sm-9"><%= bookingStatus %></dd>
      <dt class="col-sm-3">Payment reference</dt>
      <dd class="col-sm-9"><%= paymentReference %></dd>
    </dl>

    <a href="/bookings" class="btn btn-primary">Return to booking history</a>
  </main>
</body>
</html>